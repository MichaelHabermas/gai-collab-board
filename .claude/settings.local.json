{
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(bun:*)",
      "Bash(bunx vitest:*)",
      "Bash(bunx playwright test:*)",
      "Bash(bunx tsc:*)",
      "Bash(git worktree:*)",
      "Bash(git worktree remove:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(echo:*)",
      "Bash(du:*)",
      "WebFetch(domain:langfuse.com)",
      "WebFetch(domain:api.reference.langfuse.com)",
      "WebFetch(domain:www.npmjs.com)",
      "Bash(git status:*)",
      "Bash(bunx eslint:*)",
      "Bash(gh pr list:*)",
      "Bash(xargs:*)",
      "Bash(node -e:*)",
      "Bash(bunx tsx:*)",
      "Bash(Select-Object Name)",
      "Bash(sort:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/track-usage.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
